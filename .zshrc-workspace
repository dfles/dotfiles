alias pulse='cd ~/workspace/pulse && activate'

# Service
alias redis-flush='redis-cli flushdb && redis-cli flushall'
alias postgres-cleanup='sudo rm /opt/homebrew/var/postgresql\@14/postmaster.pid & brew services restart postgresql@14'

# Local app
alias django='env $(cat .env | xargs) python ./backend/manage.py'
alias django-time='stime env $(cat .env | xargs) python ./backend/manage.py'
alias django-test='django test -n --noinput'
alias django-reset-db='dropdb working && createdb -T main working && django-migrate'
alias maildev-start='activate && honcho -f ./tools/Procfile start maildev'
alias add-test-plan='./bin/add-test-plan'

# Remote DB
export PULSE_REMOTE_ENV=".env.remote"
alias honcho-remote='honcho -e .env,$PULSE_REMOTE_ENV start'
alias django-remote='env $(cat .env $PULSE_REMOTE_ENV | xargs) python ./backend/manage.py'

with-escalated() {
  local role_arn=$AWS_ESCALATION_ROLE_ARN
  local session_name="temp-escalated-$(date +%s)"

  echo "Getting temporary escalated credentials..."
  local creds=$(aws sts assume-role --role-arn "$role_arn" --role-session-name "$session_name" --output json 2>/dev/null)

  if [ $? -eq 0 ]; then
      echo "Running command with escalated permissions: $@"
      (
          export AWS_ACCESS_KEY_ID=$(echo "$creds" | jq -r '.Credentials.AccessKeyId')
          export AWS_SECRET_ACCESS_KEY=$(echo "$creds" | jq -r '.Credentials.SecretAccessKey')
          export AWS_SESSION_TOKEN=$(echo "$creds" | jq -r '.Credentials.SessionToken')
          "$@"
      )
  else
      echo "Failed to assume escalated role"
      return 1
  fi
  }
